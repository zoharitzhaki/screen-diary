# מפתח TMDb (v3 API key), חינמי - נרשמים כאן: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# מסד נתונים Turso (libSQL). בפיתוח מקומי אפשר להשאיר ריק - האפליקציה תיצור
# קובץ SQLite מקומי (local.db) לבד. בפרודקשן (Vercel) חובה למלא את שניהם.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# קוד גישה אופציונלי - אם מוגדר, כל האפליקציה תדרוש הקלדת הקוד הזה פעם אחת
# (נשמר בעוגייה) לפני שאפשר לראות אותה. בלי זה, כל מי שיש לו את הכתובת יכול
# לגלוש באפליקציה. השאירו ריק כדי לבטל את ההגנה.
APP_PASSCODE=
